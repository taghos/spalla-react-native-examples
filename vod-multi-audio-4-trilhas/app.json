{
  "expo": {
    "name": "Spalla VoD Multi-áudio 4",
    "slug": "spalla-vod-multi-audio-4",
    "version": "0.0.1",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.spalla.exemplos.vodmultiaudio4",
      "supportsTablet": true
    },
    "android": {
      "package": "com.spalla.exemplos.vodmultiaudio4"
    },
    "plugins": [
      "spalla-react-native/app.plugin.js",
      [
        "react-native-video",
        {
          "enableADSExtension": true,
          "androidExtensions": {
            "useExoplayerHls": true,
            "useExoplayerDash": false,
            "useExoplayerSmoothStreaming": false,
            "useExoplayerRtsp": false
          }
        }
      ],
      [
        "react-native-google-cast",
        {
          "receiverAppId": "SEU_APP_ID"
        }
      ]
    ]
  }
}
